# Application Environment Configuration (Placeholders Only - Never Commit Real Secrets)
APP_NAME="AI-Powered Food Waste Prediction and Redistribution Intelligence"
APP_ENV="development"
APP_VERSION="1.0.0"
ORGANIZATION_NAME="Galgotias University — ORIGIN MINI 2026 (Problem Statement 04)"

# Security & Token Signing (Generate a random 32+ byte hex string for deployment)
SECRET_KEY="replace_with_secure_random_hex_string_at_least_32_bytes"
TOKEN_EXPIRE_MINUTES=480
RATE_LIMIT_PER_MINUTE=120

# Database Connection (SQLite default; PostgreSQL supported e.g. postgresql+psycopg2://user:pass@localhost:5432/foodwaste)
DATABASE_URL="sqlite:///./data/food_waste_intelligence.db"

# API & Streamlit Connectivity
API_HOST="127.0.0.1"
API_PORT=8000
API_BASE_URL="http://127.0.0.1:8000"
STREAMLIT_PORT=8501

# Default Cafeteria Operational Parameters
DEFAULT_BREAKFAST_CAPACITY=450
DEFAULT_LUNCH_CAPACITY=750
DEFAULT_DINNER_CAPACITY=650
DEFAULT_SHORTAGE_RISK_TOLERANCE=0.15
DEFAULT_MEAL_UNIT_COST_INR=65.0
DEFAULT_SHORTAGE_PENALTY_INR=110.0
REQUIRE_MANUAL_SAFETY_APPROVAL=true
